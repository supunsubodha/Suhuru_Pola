@page "/marketplace"
@using System.Linq
@rendermode InteractiveServer

<PageTitle>Govimithuru Marketplace</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">Govimithuru Marketplace</h2>

    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Search for crops, seeds, or tools..." @bind="SearchTerm" @bind:event="oninput" />
        </div>
    </div>

    <!-- Product Grid -->
    <div class="row">
        @if (FilteredProducts.Any())
        {
            @foreach (var product in FilteredProducts)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <!-- Placeholder Image Box -->
                        <div class="card-img-top bg-light text-center py-5 border-bottom">
                            <span class="text-muted">📷 @product.Name</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-muted mb-2">@product.Category</p>
                            <h4 class="text-success fw-bold mb-3">Rs. @product.Price</h4>
                            <button class="btn btn-success mt-auto" @onclick="() => AddToCart(product)">
                                Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning">No products found matching your search.</div>
            </div>
        }
    </div>
</div>

@code {
    // 1. Define what a Product looks like
    public class Product
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Price { get; set; }
    }

    // 2. Component State
    private string SearchTerm { get; set; } = string.Empty;
    private List<Product> Products { get; set; } = new();

    // 3. Computed property that filters products based on the search bar
    private IEnumerable<Product> FilteredProducts => 
        string.IsNullOrWhiteSpace(SearchTerm) 
            ? Products 
            : Products.Where(p => p.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) || 
                                  p.Category.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

    // 4. Load mock data when the page initializes
    protected override void OnInitialized()
    {
        Products = new List<Product>
        {
            new Product { Id = 1, Name = "Organic Carrot Seeds", Category = "Seeds", Price = 450 },
            new Product { Id = 2, Name = "Premium Fertilizer (5kg)", Category = "Fertilizer", Price = 2500 },
            new Product { Id = 3, Name = "Fresh Tomatoes (1kg)", Category = "Vegetables", Price = 300 },
            new Product { Id = 4, Name = "Farming Hoe", Category = "Tools", Price = 1200 },
            new Product { Id = 5, Name = "Paddy Seeds (10kg)", Category = "Seeds", Price = 3500 },
            new Product { Id = 6, Name = "Water Pump", Category = "Machinery", Price = 45000 }
        };
    }

    // 5. Button click action
    private void AddToCart(Product product)
    {
        Console.WriteLine($"Added {product.Name} to cart!");
    }
}