@page "/profile"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations

<div class="profile-container">
    <h3 class="profile-title">My Profile</h3>

    @if (!isEditing)
    {
        <div class="profile-card">
            <div class="avatar">@GetInitial()</div>

            <div class="profile-row">
                <span class="label">Name</span>
                <span class="value">@user.Name</span>
            </div>
            <div class="profile-row">
                <span class="label">Email</span>
                <span class="value">@user.Email</span>
            </div>
            <div class="profile-row">
                <span class="label">Phone</span>
                <span class="value">@user.Phone</span>
            </div>
            <div class="profile-row">
                <span class="label">District</span>
                <span class="value">@user.District</span>
            </div>

            <button class="btn btn-primary" @onclick="StartEdit">Edit Profile</button>
        </div>
    }
    else
    {
        <div class="profile-card">
            <EditForm Model="editUser" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label>Name</label>
                    <InputText @bind-Value="editUser.Name" />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <InputText @bind-Value="editUser.Email" />
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <InputText @bind-Value="editUser.Phone" />
                </div>
                <div class="form-group">
                    <label>District</label>
                    <InputText @bind-Value="editUser.District" />
                </div>

                <div class="button-row">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                </div>
            </EditForm>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="message">@message</p>
    }
</div>

@code {
    private bool isEditing = false;
    private string message = "";

    // Temporary data. Replace with the logged-in user later.
    private UserProfile user = new UserProfile
    {
        Id = 1,
        Name = "Test Farmer",
        Email = "farmer@example.com",
        Phone = "0771234567",
        District = "Kandy"
    };

    private UserProfile editUser = new UserProfile();

    private string GetInitial()
    {
        return string.IsNullOrEmpty(user.Name) ? "?" : user.Name.Substring(0, 1).ToUpper();
    }

    private void StartEdit()
    {
        editUser = new UserProfile
        {
            Id = user.Id,
            Name = user.Name,
            Email = user.Email,
            Phone = user.Phone,
            District = user.District
        };
        message = "";
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private void Save()
    {
        // TODO: connect the database save here
        user = editUser;
        isEditing = false;
        message = "Profile saved!";
    }

    public class UserProfile
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; } = "";

        [Required, EmailAddress(ErrorMessage = "Enter a valid email")]
        public string Email { get; set; } = "";

        [Phone(ErrorMessage = "Enter a valid phone number")]
        public string Phone { get; set; } = "";

        public string District { get; set; } = "";
    }
}

