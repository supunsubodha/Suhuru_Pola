@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Buyer")]
@inject NavigationManager NavigationManager

<section class="dashboard-card-section">
	@foreach (var card in cards)
	{
		<button class="dashboard-card" @onclick="() => NavigationManager.NavigateTo(card.URL)">
			<span class="dashboard-card-icon material-symbols-outlined">@card.Icon</span>
			@if (card.Title == "Market Trends")
			{
				<span class="dashboard-card-value material-symbols-outlined">@card.DisplayValue</span>
			}
			else
			{
				<span class="dashboard-card-value">@card.DisplayValue</span>
			}
			<span class="dashboard-card-title">@card.Title</span>
		</button>
	}
</section>

@code {
    private List <DashBoardMenuCard> cards = new();

    protected override void OnInitialized() {

        cards = new List<DashBoardMenuCard > {
			new DashBoardMenuCard("Profile Feedback", "4.8", "#", "feedback"),
			new DashBoardMenuCard("My Bids", "5", "#", "gavel"),
			new DashBoardMenuCard("Saved Listings", "10", "#", "bookmark"),
			new DashBoardMenuCard("Successful Purchases", "3", "#", "credit_score"),
			new DashBoardMenuCard("Market Trends", "moving", "#", "show_chart")
        };
    }
}
