@attribute [Authorize(Roles = "Farmer")]
@inject NavigationManager NavigationManager	
@foreach (var card in cards)
	{
		<button class="dashboard-card" @onclick="() => NavigationManager.NavigateTo(card.URL)">
			<h1><span class="material-symbols-outlined">@card.Icon</span></h1>
			<h3>@card.Title</h3>
		</button>
	}

@code {
    private List <DashBoardMenuCard> cards = new();

    protected override void OnInitialized() {

        cards = new List<DashBoardMenuCard > {
            new DashBoardMenuCard("Active Listings", "#", "post_add"),
            new DashBoardMenuCard("Pending Bids", "#", "warehouse"),
            new DashBoardMenuCard("Profile Feedback", "#", "feedback"), 
            new DashBoardMenuCard("Market Trends", "#", "show_chart")
        };
    }
}
