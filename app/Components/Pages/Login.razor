@page "/login"
@attribute [StreamRendering]

<PageTitle>Govimithuru | Log in</PageTitle>
<h1>Log in</h1>
<!-- TODO: Rasanjali akka Create login form here -->

     <!--Background Leaves--> 
    <img src="" alt="">
    <img src="" alt=""> 
 
    <!--Login Container--> 
    <div class="container"> 
 
        <div class="login-box"> 
 
            <!--LOGO--> 
 
            <img src="" alt=""> 
 
            <h1>Govi Mithuru</h1> 
 
            <p class="tagline">අස්වැන්නෙන් සිනහවක්</p> 
 
            <div class="line"> 
                <hr> 
                <i class="fa-solid fa-leaf"></i> 
                <hr> 
            </div> 
 
            <h2>Login to Your Account</h2> 
 
            <!--Login Form--> 
            <form id="loginForm"> 
 
                <!--NIC--> 
                <label>NIC Number</label> 
 
                <div class="input-box"> 
                    <i class="fa-regular fa-id-card"></i> 
 
                    <input 
                        type="text" 
                        id="nic" 
                        placeholder="Enter NIC (e.g. 200112345678)" 
                        required> 
                </div> 
 
                <!--Username--> 
                <label>Username</label> 
 
                <div class="input-box"> 
 
                    <i class="fa-regular fa-user"></i> 
 
                    <input 
                        type="text" 
                        id="username" 
                        placeholder="Enter your username" 
                        required> 
                </div> 
 
                <!--Message--> 
                <p id="message"></p> 
 
                <!--Button--> 
                <button type="submit"> 
                    <i class="fa-solid fa-lock"></i>  
 
                    Login 
 
                </button> 
 
            </form> 
 
            <p class="register"> 
                Don't have an account? 
 
                <a href="#">register here</a> 
            </P>
         
        </div> 
    </div> 


