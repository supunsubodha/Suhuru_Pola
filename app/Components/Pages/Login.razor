@page "/login"
@layout EmptyLayout
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@using app.Providers
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Govimithuru | Log in</PageTitle>

    <!--Login Container--> 
    <div class="container"> 
 
        <div class="login-box"> 
 
            <!--LOGO--> 
 
            <img src="" alt=""> 
 
            <h1>Govi Mithuru</h1> 
 
            <p class="tagline">අස්වැන්නෙන් සිනහවක්</p> 
 
            <div class="line"> 
                <hr> 
                <i class="fa-solid fa-leaf"></i> 
                <hr> 
            </div> 
 
            <h2>Login to Your Account</h2> 
 
            <!--Login Form--> 
            <form id="loginForm" @onsubmit="HandleLogin" @onsubmit:preventDefault="true"> 
 
                <!--NIC--> 
                <label for="nic">NIC Number/Username/Email</label> 
 
                <div class="input-box"> 
                    <i class="fa-regular fa-id-card"></i>
                    <input type="text" name="nic" placeholder="Enter NIC (e.g. 200112345678)" required> 
                </div> 
 
                <!--Password--> 
                <label for="password">Password</label> 
 
                <div class="input-box"> 
                    <i class="fa-regular fa-user"></i> 
                    <input type="password" name="password" placeholder="Enter your password(e.g. mypassword123)" required> 
                </div> 
 
                <!--Message--> 
                <p id="message"></p> 
 
                <!--Button--> 
                <button type="submit"> 
                    <i class="fa-solid fa-lock"></i>  
                    Login 
                </button> 
 
            </form> 
 
            <p class="register"> 
                Don't have an account? 
 
                <a href="#">register here</a> 
            </P>
         
        </div> 
    </div> 


@code {
    private LoginRequest loginModel = new();
    private string? errorMessage;
    private async Task HandleLogin()
    {
        errorMessage = null;

        var response = await Http.PostAsJsonAsync("/api/auth/login", loginModel);
        if(response.IsSuccessStatusCode)
        {
            var customProvider = (CookieAuthStateProvider) AuthStateProvider;
            customProvider.NotifyAuthStateChanged();

            NavigationManager.NavigateTo("/");
        }
        else
        {
            errorMessage = "Invalid login attempt";
        }
    }

    //Model for login request
    public class LoginRequest
    {
        //Backend authentication logic is ready to handle either NIC/Email/Username for this input field
        [Required(ErrorMessage="This field is required.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be least 6 characters")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).+$", ErrorMessage = "Password must contain a digit, lowercase, uppercase, and special character.")]
        public string password { get; set; } = string.Empty;
    }
}
