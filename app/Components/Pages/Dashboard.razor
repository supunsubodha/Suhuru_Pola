@page "/"
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]


<PageTitle>Govimithuru | Dashboard</PageTitle>

<section id= "welcome-section">

<AuthorizeView>
	<Authorized>
		<h1>Welcome back, <span id="user-name">@context.User.Identity.Name</span> </h1>
	</Authorized>
</AuthorizeView>


<h2>Your Agricultural Trading Hub</h2>
</section>
<hr>
<AuthorizeView Roles = "Buyer">
	<Authorized>
		<BuyerDashboard />
	</Authorized>
</AuthorizeView>

<AuthorizeView Roles = "Farmer">
	<Authorized>
		<FarmerDashboard />
	</Authorized>
</AuthorizeView>
