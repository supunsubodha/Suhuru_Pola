@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager


<PageTitle>Govimithuru | Dashboard</PageTitle>

<section id= "welcome-section">
<h2>Hi, <span id="user-name">@name</span> 👋🏽</h2>
<h1>Welcome to the vegitable trading portal</h1>
</section>
<hr>
<section class = "dashboard-card-section">
	@foreach (var card in cards)
	{
		if (card.Role == role || card.Role == "All"){
			<button class="dashboard-card" @onclick="() => NavigationManager.NavigateTo(card.URL)">
				<h1><span class="material-symbols-outlined">@card.Icon</span></h1>
				<h3>@card.Title</h3>
			</button>
		}
	}
</section>
@code {
	string name { get; set;} = "Lara Croft";
	string role { get; set;} = "Farmer";
	string Icon { get; set;} = "post_add";

	List<DashBoardMenuCard> cards = new List<DashBoardMenuCard>
	{
		new DashBoardMenuCard("Post a New Stock", "Farmer", "#", "post_add"),
		new DashBoardMenuCard("Manage Stocks", "Farmer", "#", "warehouse"),
		new DashBoardMenuCard("Browse Market", "Buyer", "#", "search"),
		new DashBoardMenuCard("Orders and Bids", "All", "#", "shopping_cart"),
		new DashBoardMenuCard("Profile", "All", "#", "person"),
		new DashBoardMenuCard("Messages and Alerts", "All", "#", "notifications")
	};
}