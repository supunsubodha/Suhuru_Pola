@inherits LayoutComponentBase
@inject NavigationManager NavManager


<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="material-symbols-outlined">notifications</span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@code{

    public void Logout()
    {
        if (NavManager.BaseUri.Contains("localhost") || NavManager.BaseUri.Contains("127.0.0.1"))
        {
            // 1. We are testing locally. Use the absolute path with the restricted port.
            NavManager.NavigateTo("http://127.0.0.1:8080/index.html", forceLoad: true);
        }
        else
        {
            // 2. We are on the real production server. Use the relative path.
            NavManager.NavigateTo("../index.html", forceLoad: true);
        }
    }
}
